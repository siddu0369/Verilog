:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x56c5de6234c0 .scope module, "tb_clk_1mhz" "tb_clk_1mhz" 2 3;
 .timescale -9 -12;
v0x56c5de670cc0_0 .var "clk_in", 0 0;
v0x56c5de670d90_0 .net "clk_out", 0 0, v0x56c5de670a00_0;  1 drivers
v0x56c5de670e60_0 .var "rst", 0 0;
S_0x56c5de623650 .scope module, "uut" "clk_1mhz" 2 10, 3 2 0, S_0x56c5de6234c0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk_in";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 1 "clk_out";
v0x56c5de623850_0 .net "clk_in", 0 0, v0x56c5de670cc0_0;  1 drivers
v0x56c5de670a00_0 .var "clk_out", 0 0;
v0x56c5de670ac0_0 .var "count", 5 0;
v0x56c5de670b80_0 .net "rst", 0 0, v0x56c5de670e60_0;  1 drivers
E_0x56c5de65e520 .event posedge, v0x56c5de670b80_0, v0x56c5de623850_0;
    .scope S_0x56c5de623650;
T_0 ;
    %wait E_0x56c5de65e520;
    %load/vec4 v0x56c5de670b80_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 6;
    %assign/vec4 v0x56c5de670ac0_0, 0;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x56c5de670a00_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x56c5de670ac0_0;
    %pad/u 32;
    %cmpi/e 24, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %load/vec4 v0x56c5de670a00_0;
    %inv;
    %assign/vec4 v0x56c5de670a00_0, 0;
    %pushi/vec4 0, 0, 6;
    %assign/vec4 v0x56c5de670ac0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x56c5de670ac0_0;
    %addi 1, 0, 6;
    %assign/vec4 v0x56c5de670ac0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x56c5de6234c0;
T_1 ;
    %delay 10000, 0;
    %load/vec4 v0x56c5de670cc0_0;
    %inv;
    %store/vec4 v0x56c5de670cc0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x56c5de6234c0;
T_2 ;
    %vpi_call 2 24 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call 2 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56c5de6234c0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56c5de670cc0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56c5de670e60_0, 0, 1;
    %delay 50000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56c5de670e60_0, 0, 1;
    %delay 50000000, 0;
    %vpi_call 2 36 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x56c5de6234c0;
T_3 ;
    %vpi_call 2 41 "$monitor", "%0t ns : clk_out = %b", $time, v0x56c5de670d90_0 {0 0 0};
    %end;
    .thread T_3;
