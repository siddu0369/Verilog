#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5be2f74f6200 .scope module, "half_adder" "half_adder" 2 18;
 .timescale 0 0;
v0x5be2f7509460_0 .var "a", 0 0;
v0x5be2f7509550_0 .var "b", 0 0;
v0x5be2f7509660_0 .net "s", 0 0, L_0x5be2f75097d0;  1 drivers
v0x5be2f7509700_0 .net "y", 0 0, L_0x5be2f7509890;  1 drivers
S_0x5be2f74f6390 .scope module, "u1" "adder" 2 24, 2 1 0, S_0x5be2f74f6200;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "s";
L_0x5be2f75097d0 .functor XOR 1, v0x5be2f7509460_0, v0x5be2f7509550_0, C4<0>, C4<0>;
v0x5be2f74f77c0_0 .net "a", 0 0, v0x5be2f7509460_0;  1 drivers
v0x5be2f7508d80_0 .net "b", 0 0, v0x5be2f7509550_0;  1 drivers
v0x5be2f7508e40_0 .net "s", 0 0, L_0x5be2f75097d0;  alias, 1 drivers
S_0x5be2f7508f60 .scope module, "u2" "carry" 2 25, 2 8 0, S_0x5be2f74f6200;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5be2f7509890 .functor AND 1, v0x5be2f7509460_0, v0x5be2f7509550_0, C4<1>, C4<1>;
v0x5be2f7509190_0 .net "a", 0 0, v0x5be2f7509460_0;  alias, 1 drivers
v0x5be2f7509280_0 .net "b", 0 0, v0x5be2f7509550_0;  alias, 1 drivers
v0x5be2f7509350_0 .net "y", 0 0, L_0x5be2f7509890;  alias, 1 drivers
    .scope S_0x5be2f74f6200;
T_0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5be2f7509460_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5be2f7509550_0, 0, 1;
    %end;
    .thread T_0;
    .scope S_0x5be2f74f6200;
T_1 ;
    %vpi_call 2 28 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call 2 29 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5be2f74f6200 {0 0 0};
    %delay 1, 0;
    %vpi_call 2 31 "$display", "sum = %b, carry = %b", v0x5be2f7509660_0, v0x5be2f7509700_0 {0 0 0};
    %delay 1, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5be2f7509460_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5be2f7509550_0, 0, 1;
    %vpi_call 2 35 "$finish" {0 0 0};
    %end;
    .thread T_1;
