:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x595770474540 .scope module, "tb_clk_1mhz" "tb_clk_1mhz" 2 3;
 .timescale -9 -12;
v0x5957704746d0_0 .var "clk_in", 0 0;
o0x7b96f62a7048 .functor BUFZ 1, C4<z>; HiZ drive
v0x5957704bd1c0_0 .net "clk_out", 0 0, o0x7b96f62a7048;  0 drivers
v0x5957704bd280_0 .var "rst", 0 0;
    .scope S_0x595770474540;
T_0 ;
    %delay 10000, 0;
    %load/vec4 v0x5957704746d0_0;
    %inv;
    %store/vec4 v0x5957704746d0_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_0x595770474540;
T_1 ;
    %vpi_call 2 24 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call 2 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x595770474540 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5957704746d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5957704bd280_0, 0, 1;
    %delay 50000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5957704bd280_0, 0, 1;
    %delay 50000000, 0;
    %vpi_call 2 36 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x595770474540;
T_2 ;
    %vpi_call 2 41 "$monitor", "%0t ns : clk_out = %b", $time, v0x5957704bd1c0_0 {0 0 0};
    %end;
    .thread T_2;
